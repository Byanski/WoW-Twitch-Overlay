<Window x:Class="TwitchWoWOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Twitch WoW Overlay"
        Height="460" Width="720"
        MinHeight="250" MinWidth="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent"
        Foreground="#FFE680"
        FontFamily="Segoe UI, Friz Quadrata TT, Arial"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- WoW Golden Gradients -->
        <LinearGradientBrush x:Key="WowGoldBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F3D57A" Offset="0.0"/>
            <GradientStop Color="#C69533" Offset="0.3"/>
            <GradientStop Color="#8A5A16" Offset="0.7"/>
            <GradientStop Color="#53320B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WowDarkGoldBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80561B" Offset="0.0"/>
            <GradientStop Color="#4A2E0A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WowTitleTextBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF2A3" Offset="0.0"/>
            <GradientStop Color="#FFD100" Offset="0.5"/>
            <GradientStop Color="#C8960C" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WowButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38332C" Offset="0.0"/>
            <GradientStop Color="#1E1A16" Offset="0.5"/>
            <GradientStop Color="#120F0C" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WowButtonHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#544B3F" Offset="0.0"/>
            <GradientStop Color="#2E271F" Offset="0.5"/>
            <GradientStop Color="#1E1914" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- WoW Button Style -->
        <Style x:Key="WowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WowButtonBgBrush}"/>
            <Setter Property="Foreground" Value="#FFE680"/>
            <Setter Property="BorderBrush" Value="{StaticResource WowGoldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WowButtonHoverBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFEAA7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F0C0A"/>
                                <Setter Property="Foreground" Value="#C9A338"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WoW Red Close Button Style -->
        <Style x:Key="WowCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Outer Gold Rim -->
                            <Border CornerRadius="3" BorderBrush="#FFD200" BorderThickness="1.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#A31414" Offset="0.0"/>
                                        <GradientStop Color="#630606" Offset="0.6"/>
                                        <GradientStop Color="#3B0202" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Golden X symbol -->
                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="#FFD700" Stroke="#260404" StrokeThickness="0.6"
                                      Data="M 0,2 L 2,0 L 6,4 L 10,0 L 12,2 L 8,6 L 12,10 L 10,12 L 6,8 L 2,12 L 0,10 L 4,6 Z"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WoW Minimize Button Style -->
        <Style x:Key="WowMinimizeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="3" BorderBrush="#8A6020" BorderThickness="1" Background="#241E18">
                            <Rectangle Width="9" Height="2" Fill="#E6BE5A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN WOW OUTER FRAME -->
    <Border BorderBrush="{StaticResource WowGoldBorderBrush}" BorderThickness="3" CornerRadius="4" Background="Transparent">
        <!-- Inner Bevel -->
        <Border BorderBrush="#1C1309" BorderThickness="2" Background="Transparent" CornerRadius="2">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <!-- WoW Header with Portrait, Title, Close -->
                    <RowDefinition Height="38"/>
                    <!-- WoW In-Game Search & Controls Row -->
                    <RowDefinition Height="Auto"/>
                    <!-- Notification HUD (Locked/Unlocked) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Stream Container (Transparent behind video) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER ROW -->
                <Grid Grid.Row="0" x:Name="HeaderRow" MouseDown="TopBar_MouseDown" Background="#F0141118">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Twitch Portrait Medallion -->
                        <ColumnDefinition Width="*"/>    <!-- WoW Centered Gold Title -->
                        <ColumnDefinition Width="Auto"/> <!-- WoW Close / Minimize -->
                    </Grid.ColumnDefinitions>

                    <!-- TWITCH PORTRAIT MEDALLION (Matches WoW Bag Icon position) -->
                    <Grid Grid.Column="0" Margin="4,-6,0,0" VerticalAlignment="Top" Width="42" Height="42" ToolTip="Twitch Stream Companion">
                        <!-- Outer Gold Medallion Ring -->
                        <Ellipse Width="40" Height="40" Stroke="{StaticResource WowGoldBorderBrush}" StrokeThickness="2.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.3" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#9146FF" Offset="0.0"/>
                                    <GradientStop Color="#4B1F8C" Offset="0.7"/>
                                    <GradientStop Color="#1F0742" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Inner Gold Accent Ring -->
                        <Ellipse Width="33" Height="33" Stroke="#FFD700" StrokeThickness="1" Opacity="0.6"/>

                        <!-- Twitch Glitch Icon inside the golden ring -->
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Twitch Speech Bubble Body -->
                            <Path Fill="#FFFFFF" Data="M 2,0 L 18,0 C 19.1,0 20,0.9 20,2 L 20,14 C 20,15.1 19.1,16 18,16 L 14,16 L 10,20 L 10,16 L 5,16 L 2,13 L 2,2 C 2,0.9 2.9,0 2,0 Z">
                                <Path.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Direction="315"/>
                                </Path.Effect>
                            </Path>
                            <!-- Twitch Left Eye -->
                            <Rectangle Canvas.Left="7" Canvas.Top="5" Width="2" Height="5" Fill="#4B1F8C"/>
                            <!-- Twitch Right Eye -->
                            <Rectangle Canvas.Left="12" Canvas.Top="5" Width="2" Height="5" Fill="#4B1F8C"/>
                        </Canvas>
                    </Grid>

                    <!-- WOW GOLDEN TITLE -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-20,0,0,0">
                        <TextBlock x:Name="OverlayTitle" Text="Twitch Stream" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource WowTitleTextBrush}" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1.5" Direction="315"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- WINDOW BUTTONS (WoW Red Close Button & Minimize) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource WowMinimizeButtonStyle}" Click="MinimizeButton_Click" Margin="0,0,6,0" ToolTip="Minimize"/>
                        <Button Style="{StaticResource WowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close Overlay"/>
                    </StackPanel>
                </Grid>

                <!-- WOW SEARCH & CONTROLS ROW -->
                <Border Grid.Row="1" x:Name="ControlsRow" Background="#F00F0D13" BorderBrush="#261A0C" BorderThickness="0,1,0,1" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>    <!-- In-Game Search Bar -->
                            <ColumnDefinition Width="Auto"/> <!-- View Mode -->
                            <ColumnDefinition Width="Auto"/> <!-- Opacity -->
                            <ColumnDefinition Width="Auto"/> <!-- Volume -->
                            <ColumnDefinition Width="Auto"/> <!-- Lock Button -->
                        </Grid.ColumnDefinitions>

                        <!-- WOW BAG SEARCH STYLE INPUT -->
                        <Border Grid.Column="0" Background="#070709" BorderBrush="#3D3528" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Search Magnifier Icon (Just like WoW bag search) -->
                                <Path Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                      Fill="#998155" Stretch="Uniform" Width="11" Height="11"
                                      Data="M 6.5,0 C 2.9,0 0,2.9 0,6.5 C 0,10.1 2.9,13 6.5,13 C 8.0,13 9.4,12.5 10.5,11.6 L 14.9,16 L 16,14.9 L 11.6,10.5 C 12.5,9.4 13,8.0 13,6.5 C 13,2.9 10.1,0 6.5,0 Z M 6.5,2 C 9.0,2 11,4.0 11,6.5 C 11,9.0 9.0,11 6.5,11 C 4.0,11 2,9.0 2,6.5 C 2,4.0 4.0,2 6.5,2 Z"/>

                                <TextBox Grid.Column="1" x:Name="ChannelInput"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFF2A3" CaretBrush="#FFD100"
                                         FontSize="12" VerticalAlignment="Center"
                                         TextChanged="ChannelInput_TextChanged"
                                         KeyDown="ChannelInput_KeyDown"
                                         ToolTip="Enter streamer name or Twitch URL (Press Enter)"/>

                                <TextBlock Grid.Column="1" x:Name="ChannelPlaceholder"
                                           Text="Search or enter channel..."
                                           Foreground="#6E624A" FontSize="11"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- MODE SELECTOR -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Style="{StaticResource WowButtonStyle}" Content="Load" Click="GoButton_Click" Margin="0,0,6,0" ToolTip="Load Channel"/>

                            <ComboBox x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged"
                                      Background="#1E1914" Foreground="#FFE680" BorderBrush="#8A6020"
                                      FontSize="11" Height="22" VerticalAlignment="Center" ToolTip="Display Mode">
                                <ComboBoxItem Content="Video Only" IsSelected="True" Tag="popout" />
                                <ComboBoxItem Content="Stream + Chat" Tag="full" />
                                <ComboBoxItem Content="Chat Only" Tag="chat" />
                            </ComboBox>

                            <Button Style="{StaticResource WowButtonStyle}" Content="⟳" Click="ReloadButton_Click" Margin="4,0,0,0" ToolTip="Reload Stream"/>
                        </StackPanel>

                        <!-- OPACITY SLIDER -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="OpacityLabel" Text="100%" Foreground="#D4A751" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Width="34" TextAlignment="Right"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0"
                                    Width="65" VerticalAlignment="Center"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    ToolTip="Adjust Overlay Transparency"/>
                        </StackPanel>

                        <!-- VOLUME CONTROLS -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button x:Name="MuteButton" Content="🔊" Click="MuteButton_Click"
                                    Background="Transparent" BorderThickness="0" Foreground="#FFD100"
                                    FontSize="11" Cursor="Hand" Padding="2,0" Margin="0,0,2,0"
                                    ToolTip="Toggle Mute"/>
                            <TextBlock x:Name="VolumeLabel" Text="100%" Foreground="#D4A751" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Width="34" TextAlignment="Right"/>
                            <Slider x:Name="VolumeSlider" Minimum="0.0" Maximum="1.0" Value="1.0"
                                    Width="55" VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    ToolTip="Adjust Stream Volume"/>
                        </StackPanel>

                        <!-- CLICK-THROUGH LOCK BUTTON (Styled like a WoW Action Button) -->
                        <Button Grid.Column="4" x:Name="LockToggleButton" Style="{StaticResource WowButtonStyle}" Click="LockToggleButton_Click"
                                ToolTip="Toggle Click-Through Mode (Hotkey: Ctrl + Shift + T or Ctrl + F9)"
                                BorderBrush="#FFCC00" Padding="8,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒 " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="Pass Clicks" FontSize="11" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- NOTIFICATION BANNER (WoW Gold Alert Banner) -->
                <Border Grid.Row="2" x:Name="NotificationBanner" Background="#D9161005" BorderBrush="#C69533" BorderThickness="0,1,0,1" Padding="8,3" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="NotificationText" Foreground="#00FFCC" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="🔒 Click-Through LOCKED. Clicks pass to WoW. Press [Ctrl + Shift + T] to unlock."/>
                    </Grid>
                </Border>

                <!-- STREAM VIEWPORT (Fully transparent background so video opacity reveals the game) -->
                <Border Grid.Row="3" Background="Transparent" BorderBrush="#8A5A16" BorderThickness="1" Margin="1,1,1,1">
                    <Grid Background="Transparent">
                        <wv2:WebView2 x:Name="StreamWebView" />

                        <!-- Loading Placeholder -->
                        <Border x:Name="LoadingOverlay" Background="#E00C0C10" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Summoning Stream..." Foreground="{StaticResource WowTitleTextBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Connecting to Twitch player" Foreground="#8A7A5A" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- CLICK-THROUGH ACTIVE HUD BADGE (Visible in corner when locked) -->
                        <Border x:Name="ClickThroughBadge"
                                Background="#D9120F09"
                                BorderBrush="{StaticResource WowGoldBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                Padding="8,4"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#00FF88" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PASS-THROUGH ON [Ctrl+Shift+T]" Foreground="#FFE680" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Corner Resize Grip -->
                        <Thumb x:Name="ResizeGripThumb" Width="14" Height="14"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Cursor="SizeNWSE" DragDelta="ResizeGripThumb_DragDelta"
                               Opacity="0.7">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Path Fill="#C69533" Data="M 14,0 L 14,14 L 0,14 Z"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
